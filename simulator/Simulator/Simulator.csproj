<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType> 
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Automatak.Simulator</RootNamespace>
    <AssemblyName>SimulatorApplication</AssemblyName>
    <ApplicationIcon>automatak.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <Version>1.0.0-alpha.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-alpha.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="opendnp3" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pomoc.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_LICENSES.txt" Link="THIRD_PARTY_LICENSES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commons\Commons.csproj" />
    <ProjectReference Include="..\DNP3\DNP3Simulator\DNP3Module.csproj" />
    <ProjectReference Include="..\SimulatorAPI\ModuleAPI.csproj" />
    <ProjectReference Include="..\SimulatorUI\SimulatorUI.csproj" />
  </ItemGroup>
</Project>